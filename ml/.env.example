# H-MAP ML / ETL environment
# Copy this file to ml/.env and fill in real values. ml/.env is gitignored.

# ─── MySQL connection (remote server) ─────────────────────────────────────
DB_HOST=
DB_PORT=3306
DB_NAME=hmap_db
DB_USER=
DB_PASSWORD=

# The ETL will run CREATE DATABASE IF NOT EXISTS using these credentials,
# so DB_USER must have CREATE privilege on the server. After initial load
# you can rotate to a least-privilege user (SELECT/INSERT/UPDATE on hmap_db).

# ─── ML service ───────────────────────────────────────────────────────────
ML_LOG_LEVEL=info
MODEL_DIR=./models
# Port the FastAPI service listens on. Production deploy uses 5001;
# staging uses 5002 (see docs/DEPLOYMENT.md). Local dev defaults to 5000.
ML_PORT=5000

# ─── Geocoding ────────────────────────────────────────────────────────────
# Google Geocoding API key — used by ml/geocode_compare.py and the production
# geocoding pipeline. Restrict the key to the Geocoding API in Google Cloud
# Console and set a low billing alert (~$5) since the $200/mo free tier
# covers H-MAP's projected volume.
GOOGLE_MAPS_API_KEY=

# Nominatim user-agent — required by OSM usage policy. Use an identifier
# that lets the OSM admins contact you if your traffic causes issues.
# Format: "<project> (<contact-email>)"
NOMINATIM_USER_AGENT=hmap-capstone (hrmo@paranaque.gov.ph)

# ─── Encrypted backups (ml/backup_db.py, docs/BACKUP_AND_RESTORE.md) ──────
BACKUP_DIR=/var/backups/hmap
BACKUP_KEY_FILE=/etc/hmap/backup.key
BACKUP_RETENTION_DAYS=30
# Scratch database for weekly test restorations; emptied after each check.
RESTORE_TEST_DB=hmap_db_restore_test
# Leave blank to use mysqldump / mysql / openssl from PATH.
MYSQLDUMP_BIN=
MYSQL_BIN=
OPENSSL_BIN=

{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "hmap/app",
    "type": "project",
    "description": "H-MAP — Heat Map Disease Surveillance and Outbreak Prediction System",
    "keywords": ["hmap", "pidsr", "cesu", "paranaque"],
    "license": "MIT",
    "require": {
        "php": "^7.4|^8.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "laravel/framework": "^8.83",
        "laravel/tinker": "^2.7"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^5.10",
        "phpunit/phpunit": "^9.5.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "audit": {
            "abandoned": "ignore"
        }
    },
    "_policy_note": "Laravel 8 is EOL. The advisory-block check is disabled below because the production server is Ubuntu 20.04 (focal) and cannot install PHP 8.x until the OS is upgraded to 22.04 (jammy). Plan: schedule OS upgrade with BPLO IT post-defense (2026-05-26), then re-base on Laravel 11 / PHP 8.3. See docs/DEPLOYMENT.md and HRMO memory project_php_upgrade_blocked_2026_05_20.md.",
    "policy": false,
    "minimum-stability": "stable",
    "prefer-stable": true
}
